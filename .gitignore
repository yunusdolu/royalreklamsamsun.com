# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ham gorsel kaynaklari — islenmis surumleri public/images/ altinda
# duruyor; 39 MB'lik orijinaller depoya girmesin
hizmetkart gorseller/
hizmetkart görseller/

# Ham gorsel kaynaklari — siteye giren surumleri public/ altinda duruyor,
# 54 MB ham dosyayi depoda tutmanin karsiligi yok.
/royal hizmet kapak fotoları/
/Royal Reklam referans işler/

# Gecici calisma betikleri (tarayici surucusu, olcum, tek seferlik donusum)
/.tmp-*

# /brag tanıtım videosu çıktıları (video, kareler, ara dosyalar)
/brag-output*/
