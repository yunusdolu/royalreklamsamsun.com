# Supabase — yönetim paneli (/admin) ve panelden düzenlenen içerik.
#
# Değerler: Supabase → Project Settings → API Keys.
# Üçü de boş bırakılabilir; o zaman panel devre dışı kalır ve site içeriğini
# src/content/ altındaki dosyalardan okumaya devam eder.
#
# Vercel'de de aynı üç değişkeni tanımla (Settings → Environment Variables).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Gizli anahtar. Yalnızca sunucuda kullanılır, tarayıcıya hiç gitmez.
SUPABASE_SECRET_KEY=
